# Cloudflare Pages 专用：它不读 vercel.json，缓存/安全头必须写在这里。
# 内容与根目录 vercel.json 的 headers 保持一致，改一处记得同步另一处。
# 语法：<匹配路径> 换行 缩进两格的 Header: value

# 带内容哈希的构建产物，可以永久缓存
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 启动动画素材：更新频率低，但不带哈希，别用 immutable
/intro.webm
  Cache-Control: public, max-age=604800
/intro.mp4
  Cache-Control: public, max-age=604800
/intro-poster.jpg
  Cache-Control: public, max-age=604800

# 图标 / 社交分享图
/favicon.svg
  Cache-Control: public, max-age=86400
/logo.svg
  Cache-Control: public, max-age=86400
/logo-mark.svg
  Cache-Control: public, max-age=86400
/og-cover.jpg
  Cache-Control: public, max-age=86400

# 全局安全头
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
